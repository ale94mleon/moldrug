{
	"name": "moldrug",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"   // relative to devcontainer.json
	},

	"remoteUser": "user",

	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/user/.claude,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/user/.claude",
		// The image only ships C.UTF-8; a host locale forwarded by VS Code (e.g. en_US.UTF-8)
		// makes locale.setlocale(LC_ALL, '') fail, which breaks sphinx-build.
		"LC_ALL": "C.UTF-8"
	},

	// Editable install + test deps (pytest, crem) + docs deps.
	// safe.directory avoids git "dubious ownership" errors, which versioningit would hit on the mounted repo.
	"postCreateCommand": "git config --global --add safe.directory '*' && pip install -e '.[dev]' -r requirements_docs.txt",

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"ms-python.python",
				"ms-toolsai.jupyter"
			],
			"settings": {
				"python.defaultInterpreterPath": "/home/user/miniforge3/envs/moldrug/bin/python"
			}
		}
	}
}
